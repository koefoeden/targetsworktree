\alias{targetsworktree}
\alias{targetsworktree-package}
\docType{package}
\title{Safe Targets Stores for Git Worktrees}
\description{
Configures snapshot-backed targets stores in existing Git worktrees, converts
them to endpoint-scoped writable stores, reconciles cached values before
guarded runs, and quarantines writable output during teardown.
}
